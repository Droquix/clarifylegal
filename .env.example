# ClarifyLegal Environment Variables
# Copy this file to .env in backend/ directory. DO NOT commit .env to git.

NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here
NVIDIA_MODEL=meta/llama-3.2-11b-vision-instruct
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://clarifylegal.vercel.app
MAX_DOCUMENT_CHARS=30000
MAX_QUESTION_CHARS=1000
MAX_PDF_PAGES=100
